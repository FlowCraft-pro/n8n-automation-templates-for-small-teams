{
  "name": "Lead Capture & Auto-Reply",
  "nodes": [
    {
      "id": "775e2345-c0b3-4b35-b0df-9afe791030bd",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "ba6f885a-53d3-47fa-9da9-2dd2efe4efd0",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "8cd816c6-5c26-4795-ac41-d23409013295",
              "name": "name",
              "value": "={{ $json.body.name }}",
              "type": "string"
            },
            {
              "id": "04e31005-bf0d-4ada-8957-ffb2ced1fd14",
              "name": "email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "91df8b04-ee84-4dba-897e-816a3dd45a9f",
              "name": "source",
              "value": "={{ $json.body.source || 'website' }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "80aa10cc-5731-4ce1-bba1-586463f5abb0",
      "name": "Has Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e18189f5-1293-4659-8086-5413a0d4ac95",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d399139b-6292-4e8b-a9cf-c29182c48501",
      "name": "Forward to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.CRM_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"name\":\"{{ $json.name }}\",\"email\":\"{{ $json.email }}\",\"source\":\"{{ $json.source }}\"}"
      }
    },
    {
      "id": "8b25f5da-a160-403c-8743-955baacfaf07",
      "name": "Skip (no email)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        420
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Lead": {
      "main": [
        [
          {
            "node": "Has Email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Email?": {
      "main": [
        [
          {
            "node": "Forward to CRM",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip (no email)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "description": "Accepts a POSTed lead (name, email, source), validates email, forwards to your CRM webhook. Configure CRM_WEBHOOK_URL in n8n variables."
}