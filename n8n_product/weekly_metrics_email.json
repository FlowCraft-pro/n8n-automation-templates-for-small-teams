{
  "name": "Weekly Metrics Email",
  "nodes": [
    {
      "id": "eefb350e-b30f-440a-8784-d750d699cb2f",
      "name": "Weekly Mon 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "9db6f82e-d91f-493a-adc9-416281867d6e",
      "name": "Build Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "8d29ebfc-fb2a-4879-99a2-28dadecc6597",
              "name": "subject",
              "value": "Weekly metrics digest",
              "type": "string"
            },
            {
              "id": "038151a2-262b-4a84-9ffd-7305c46db12e",
              "name": "body",
              "value": "Here is your weekly metrics summary. Review KPIs and top priorities.",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "7ece8747-ee5f-4e9c-b2de-445d6469ef87",
      "name": "Send Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.EMAIL_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"to\":\"{{ $vars.REPORT_RECIPIENT }}\",\"subject\":\"{{ $json.subject }}\",\"body\":\"{{ $json.body }}\"}"
      }
    }
  ],
  "connections": {
    "Weekly Mon 9am": {
      "main": [
        [
          {
            "node": "Build Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Report": {
      "main": [
        [
          {
            "node": "Send Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "description": "Monday 9am digest email via your email webhook. Configure EMAIL_WEBHOOK_URL and REPORT_RECIPIENT."
}