{
  "name": "Social Post Publisher",
  "nodes": [
    {
      "id": "bb055541-2dcf-4c92-9fb8-63b5bb547090",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {}
    },
    {
      "id": "6771d54a-3727-443d-ad92-f0c54313eea4",
      "name": "Set Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "e7644a54-899d-4d4e-833d-2a4a657a8273",
              "name": "text",
              "value": "New post created at {{$now}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "06c4ef6c-b35d-4903-ba42-83210239b739",
      "name": "Publish to Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.PUBLISH_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\":\"{{ $json.text }}\"}"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Content": {
      "main": [
        [
          {
            "node": "Publish to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "description": "Manual trigger sets content and publishes to your publishing webhook. Configure PUBLISH_WEBHOOK_URL."
}