{
  "name": "Webhook Row Logger",
  "nodes": [
    {
      "id": "5b4e2033-c6bc-4971-b62d-8fd4f7c7f544",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "row-log",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "153dbb22-4f40-4161-ac0d-9de18cc4f6ca",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b=$input.first().json.body||{}; return [{json:{...b, receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "c3c0b042-07e0-46f7-a2a7-68b3789b3553",
      "name": "Forward Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.LOG_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Forward Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "description": "Logs any POSTed JSON payload plus timestamp to your log webhook. Configure LOG_WEBHOOK_URL."
}