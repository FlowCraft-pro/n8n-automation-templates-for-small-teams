{
  "name": "Customer Feedback Collector",
  "nodes": [
    {
      "id": "31017c20-ee11-4f9c-b9b9-d0d85af863b6",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "feedback",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "538f6aed-58f4-4e9c-8292-78776a99d3dd",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b=$input.first().json.body||{}; return [{json:{name:b.name||'anonymous',rating:Number(b.rating)||0,comment:b.comment||'',receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "25076849-de98-43f8-87ad-94c7eeee827a",
      "name": "Forward Feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.FEEDBACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Forward Feedback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "description": "Collects rating + comment via webhook and forwards to your storage webhook. Configure FEEDBACK_WEBHOOK_URL."
}