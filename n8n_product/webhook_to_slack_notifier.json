{
  "name": "Webhook to Slack Notifier",
  "nodes": [
    {
      "id": "3de4f223-834a-4d72-8d64-89b6ca46ade5",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "notify",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "a95659f6-67c7-4e3c-a696-52c1d2693adf",
      "name": "To Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\":\"{{ $json.body.message }}\"}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "To Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "description": "POST a message to path 'notify'; forwards to Slack webhook. Configure SLACK_WEBHOOK_URL."
}