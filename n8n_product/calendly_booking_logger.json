{
  "name": "Calendly Booking Logger",
  "nodes": [
    {
      "id": "7ffdc07f-b28e-4129-98bc-6a9d744c76d4",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "calendly",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "6e335757-de36-4f02-9402-492d80ac8f71",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b=$input.first().json.body||{}; return [{json:{invitee:b.invitee?.name||'',email:b.invitee?.email||'',event:b.event_type?.name||'',start:b.start_time||'',receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "2999fbf0-626e-498d-9615-20b98594b0f1",
      "name": "Forward Calendar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.CALENDAR_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Forward Calendar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "description": "Logs Calendly booking webhooks to your storage webhook. Configure CALENDAR_WEBHOOK_URL."
}